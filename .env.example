# Copie para .env.local e preencha. Supabase → Connect (ou Project Settings → API Keys).
# A chave "publishable" (sb_publishable_...) é pública por design: quem protege os dados é o RLS do banco.
# NUNCA coloque aqui a chave "secret" / "service_role".
NEXT_PUBLIC_SUPABASE_URL=https://odaeekmnzygxnlxubfon.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------- Só no SERVIDOR (sem NEXT_PUBLIC_): nunca vão ao navegador ----------
# Endereço público do app (monta os links de retorno do login do YouTube/TikTok)
APP_URL=https://operacional-os.vercel.app
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...). Só servidor!
SUPABASE_SECRET_KEY=
# Chave de 32 bytes em base64 que criptografa os tokens das redes. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Senha do agendamento diário de métricas (Vercel Cron). Qualquer texto aleatório longo.
CRON_SECRET=
# Google Cloud → Credentials → OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok for Developers → seu app → Client key / Client secret
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

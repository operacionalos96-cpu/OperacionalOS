# Copie para .env.local. Nunca coloque valores reais neste arquivo versionado.
# Obtenha URL e publishable key no painel do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLOQUE_SUA_CHAVE

# Chave server-side do Supabase: privilegiada, ignora RLS. Nunca exponha ao navegador.
SUPABASE_SECRET_KEY=

# URL canônica do app em produção (usada em callbacks e links de autenticação).
APP_URL=http://localhost:3000

# Gere cada chave com 32 bytes aleatórios codificados em Base64.
# Exemplo de geração: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde as chaves com segurança; perdê-las pode impedir descriptografar segredos já armazenados.
TOKEN_ENCRYPTION_KEY=
VAULT_ENCRYPTION_KEY=

# Integrações opcionais
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Agendador: configure o mesmo segredo no cron e no ambiente do app.
CRON_SECRET=

# Webhooks de entrada (configure apenas o provedor que usar).
HOTMART_HOTTOK=
KIWIFY_TOKEN=
WEBHOOK_OWNER_ID=

# Demonstração local apenas; não habilite em produção.
NEXT_PUBLIC_SANDBOX=0

# Variáveis abaixo são para executar workers locais, não necessárias para o app web.
# OOS_URL=https://seu-app.vercel.app
# OOS_WORKER_TOKEN=
# OOS_ANALISTA_TOKEN=
# BROWSER=
# FFMPEG=ffmpeg

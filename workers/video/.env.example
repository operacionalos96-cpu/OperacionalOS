# Endereço do Operacional OS
OOS_URL=https://operacional-os.vercel.app
# Token do worker (AI Office → Workers → Novo worker: agente "Video Studio", capability "video_render",
# escopos queue:read, jobs:claim, jobs:execute, context:read). Aparece UMA vez.
OOS_WORKER_TOKEN=
# Opcional: caminho do Edge/Chrome e do ffmpeg, se não forem os padrões
# BROWSER=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# FFMPEG=ffmpeg

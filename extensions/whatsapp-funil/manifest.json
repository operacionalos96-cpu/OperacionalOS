{
  "manifest_version": 3,
  "name": "Funil HZK",
  "version": "1.6.1",
  "description": "Funil do Operacional OS dentro do WhatsApp Web: mostra o lead e o próximo passo, escreve a mensagem e anexa o áudio ou vídeo. Com o agente ligado, envia e responde sozinho.",
  "icons": {
    "16": "icons/hzk-16.png",
    "32": "icons/hzk-32.png",
    "48": "icons/hzk-48.png",
    "128": "icons/hzk-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://operacional-os.vercel.app/*",
    "http://localhost:3000/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Funil HZK",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/hzk-16.png",
      "32": "icons/hzk-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "mic.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "analyze.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "111"
}
